#   https://github.com/cdrubin/bash_ui



# internal variables
_stdin=""
_options=""
_display_options=""
_mode="single"
_selected_line=1
_chosen=""
_line_count=0
_top=0
_row=0

# ansi handling
ESC="\0033["
SEP=";"
ELLIPSIS="…"
_sx=0; _sy=0

# shell
_oldIFS=IFS
IFS=$'\n'


# read from stdin and don't block if empty
if [ ! -t 0 ]; then
    read -d '' _stdin
fi

# default way of handling options
_options=$_stdin


# look for mode parameter
if [ $# -gt 0 ]; then
    if [[ $1 =~ multi ]]; then
        # set mode and add multiple select line to options
        _mode=multiple
        _options=$_stdin$'\n'">"    
    elif [[ $1 =~ clean ]]; then
        # leave less trace of ui in terminal
        _mode=clean
    fi
fi

# count number of lines now in _options
_line_count=$(($(printf "%s\n" "$_options" | wc -l)))
#echo $_line_count


function gotoXY() {
    x=$1; y=$2
	echo -en "${ESC}$((y))${SEP}$((x))H"
}


function setXY() {
    exec < /dev/tty
    local _oldstty=$(stty -g)
    stty raw -echo min 0
    # flush any stray input before querying cursor position
    read -rst 0.1 -n 10000 _discard 2>/dev/null || true
    echo -en "\033[6n" > /dev/tty
    IFS=';' read -r -d R -t 2 -a pos
    stty $_oldstty
    _sx=$((${pos[1]} - 1))
    _sy=$((${pos[0]:2}))
}


function hideCursor() {
	echo -en "${ESC}?25l"
}


function showCursor() {
	echo -en "${ESC}?25h"
}


function set_row() {
	setXY
	_row=$((_sy - 1))
}


# Painting is kept flicker-free three ways:
#  - a line is written first and the rest of the row cleared after (\033[K), so there is never a blank frame;
#  - on a key press only the two rows that changed are redrawn, not the whole list;
#  - each redraw is wrapped in synchronized-output markers (?2026), so terminals that support them paint it in one go
#    (others ignore the markers).
function syncBegin() { echo -ne "\033[?2026h"; }
function syncEnd()   { echo -ne "\033[?2026l"; }

# draw option number $1 on its own row (highlighted when selected)
function drawLine() {
    local n=$1 text
    text=$(sed -n "${n}p" <<< "$_options")
    gotoXY 0 $((_top + n))
    if [ "$n" -eq "$_selected_line" ]; then
        echo -ne "\033[7m"; echo -n "$text"; echo -ne "\033[0m\033[K"
    else
        echo -n "$text"; echo -ne "\033[K"
    fi
}

# leave the cursor just below the list, where a plain (non-clean) run expects to carry on
function park() {
    gotoXY 0 $((_top + _line_count + 1))
}

# redraw everything
function refresh() {
    syncBegin
    echo -ne "\033[?7l"                     # disable wordwrap
    local n
    for ((n = 1; n <= _line_count; n++)); do drawLine $n; done
    echo -ne "\033[?7h"                     # enable wordwrap
    park
    syncEnd
}

# redraw only the two rows whose highlight changed: move_selection <old> <new>
function moveSelection() {
    syncBegin
    echo -ne "\033[?7l"
    drawLine "$1"; drawLine "$2"
    echo -ne "\033[?7h"
    park
    syncEnd
}



# print out the choices
echo -ne "\x1b[?7l"          # disable wordwrap
printf "%s\n" "$_options"
echo -ne "\x1b[?7h"          # enable wordwrap


# initialize
set_row
_top=$((_row - _line_count))
trap showCursor EXIT                         # always give the cursor back
hideCursor                                   # hidden once for the whole selection, not on every redraw
refresh


_selected_line=1

# flush any buffered input from the terminal before reading arrow keys
read -rst 0.1 -n 10000 _discard 2>/dev/null || true

while read -sn1 key; do
    k1=""; k2=""

    if [ "$key" == $'\e' ]; then
        read -sn1 -t 1 k1; read -sn1 -t 1 k2;
    elif [ "$key" == "" ]; then
        if [ "$_mode" == "multiple" ]; then

            # if on the last option (multiple) then break
            if [ $_selected_line -eq $_line_count ]; then
                break
            # if on an option then add/remove it
            else
                _option_chosen=$( echo "${_options}" | sed "${_selected_line}q;d" )
                
                # if _chosen contains _option_chosen then remove it
                if echo "$_chosen" | grep "^${_option_chosen}$" > /dev/null; then
                    _chosen=$( echo "${_chosen}" | grep -v "^$_option_chosen\$" )
                # otherwise add it
                else
                    _chosen="$_chosen"$'\n'"$_option_chosen"
                    # remove empty lines
                    _chosen=$( echo "${_chosen}" | sed '/^$/d' )
                fi
                
                _chosen_commas=$( echo "$_chosen" | awk -v ORS=', ' '1' | sed 's/, $//' )
                
                _options=$_stdin$'\n'"> ${_chosen_commas}"
                refresh
            fi
        else
            _chosen=$( echo "${_options}" | sed "${_selected_line}q;d" )
            break
        fi
    fi
    key+=${k1}${k2}

    case "$key" in
        $'\e[A'|$'\e0A')  # up arrow
            if [ $_selected_line -gt 1 ]; then _prev=$_selected_line; ((_selected_line--)); moveSelection $_prev $_selected_line; fi;;

        $'\e[B'|$'\e0B')  # down arrow
            if [ $_selected_line -lt $_line_count ]; then _prev=$_selected_line; ((_selected_line++)); moveSelection $_prev $_selected_line; fi;;
    esac
done

if [ "$_mode" == "clean" ]; then
    echo -e "\033[${_top};0H"               # jump to beginning of line _top
    for i in $(seq ${_line_count}); do
      echo -e "\033[2K"                     # clear line
    done
    echo -e "\033[${_top};0H"               # jump to beginning of line _top
    echo "$_chosen"
fi

echo "$_chosen" > /dev/stderr

IFS=_oldIFS
